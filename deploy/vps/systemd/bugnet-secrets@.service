# The secrets route, bugnet-edge --role secrets (DP 15.3)
[Unit]
Description=Bugnet secrets route %i
After=network-online.target
Wants=network-online.target

[Service]
User=bugnet-secrets
Group=bugnet-secrets
ExecStart=/opt/bugnet/edge/%i/bugnet-edge --role secrets -config /etc/bugnet/secrets-route.toml
EnvironmentFile=/etc/bugnet/secrets-route.env
StateDirectory=bugnet-secrets
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
LimitNOFILE=65536
LimitCORE=0
TimeoutStopSec=90
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
