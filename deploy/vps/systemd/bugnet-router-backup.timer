# Runs bugnet-router-backup.service every night, an hour after the Payments backup; Persistent
# catches up a run missed while the server was down
[Unit]
Description=Bugnet router backup, every night

[Timer]
OnCalendar=*-*-* 03:15:00 UTC
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
