# Settings for scripts/dev-up.sh. Copy this file to .env and adjust it.
# Secrets are not set here. dev-up.sh writes them to .env.keys with bugnet-dev keys, they are
# BUGNET_INTERNAL_TOKEN, BUGNET_ORDER_TOKEN_PUBLIC_KEY, BUGNET_ORDER_PRIVATE_KEY,
# BUGNET_HANDLE_KEY, BUGNET_EVENT_SIGNING_KEY and BUGNET_EVENT_PUBLIC_KEY.

# The router's own database, create it once with createdb bugnet_router_dev
BUGNET_DATABASE_URL=postgres://localhost:5432/bugnet_router_dev?sslmode=disable
BUGNET_VALKEY_ADDR=localhost:6379
BUGNET_VALKEY_PREFIX=bn:dev:

# router-api serves the API here, and bugnet-dev calls it at BUGNET_API_URL
BUGNET_LISTEN_ADDR=127.0.0.1:8080
BUGNET_API_URL=http://127.0.0.1:8080
# router-worker answers /healthz and /readyz here
BUGNET_WORKER_LISTEN_ADDR=127.0.0.1:8081

# Paths are relative to the repository root, where dev-up.sh runs
BUGNET_PACKAGES_FILE=scripts/dev-packages.json

# The local provider runs commands on this machine, never point it at untrusted code
BUGNET_PROVIDERS=local
BUGNET_ENABLE_LOCAL_PROVIDER=1
# Defaults to bin/local and bin/bugnet-run when empty
BUGNET_LOCAL_ROOT=
BUGNET_LOCAL_RUNNER=

# Signed events are posted here, events stay pending in the outbox when it is empty
BUGNET_EVENTS_URL=
