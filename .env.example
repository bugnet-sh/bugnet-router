# Secrets only. Copy this file to .env and paste each key right after the = sign. The scripts
# read this file with the shell, so paste a plain key as it is, and wrap a value in single
# quotes when it holds spaces or shell characters such as & $ ; ( or ). Every other setting
# lives in config/dev.toml. dev-up.sh writes the router's own generated secrets to .env.keys.
# A provider needs its key only when it is listed in providers in the settings file, and the
# live tests of a provider need its key.

# The router's own Postgres database, create it once with createdb bugnet_router_dev. pool_max_conns
# gives router-worker's 32 River workers a connection each, with room to spare
BUGNET_DATABASE_URL='postgres://localhost:5432/bugnet_router_dev?sslmode=disable&pool_max_conns=48'

# boxd, created at https://app.boxd.sh/keys, starts with bxd_
BOXD_API_KEY=

# E2B, created at https://console.e2b.dev/?tab=keys, starts with e2b_
E2B_API_KEY=

# Koyeb, created at https://app.koyeb.com/settings/api
KOYEB_API_TOKEN=

# Boat, created at https://boat.dev/dashboard?tab=api-keys, starts with boat_
BOAT_API_KEY=

# Caller tokens, one per edge process, each empty or at least 32 characters and unlike the
# others. An empty token admits no calls, so a router without edges serves only the gateway.
# bugnet-dev keys writes fresh ones to .env.keys, which dev-up.sh reads after this file.
BUGNET_EDGE_TOKEN=
BUGNET_SECRETS_TOKEN=
BUGNET_SSH_TOKEN=
BUGNET_EGRESS_TOKEN=

# The bnf_ token the router's private fetch opens egress tunnels with, by the same rules
BUGNET_EGRESS_FETCH_TOKEN=

# The operator's token for OperatorService, which bugnet-dev's operator commands send, by the
# same rules
BUGNET_OPERATOR_TOKEN=

# Payments' token for PaymentsService, the same name and value as in Payments' own environment,
# by the same rules. It is not BUGNET_PAYMENTS_TOKEN, the gateway's token for Payments.
# router-worker sends it to Payments' stats totals call while stats.listen_addr is set.
BUGNET_PAYMENTS_ROUTER_TOKEN=

# Required. The data-plane root keys as <id>:<base64 of 32 bytes> entries separated by commas,
# newest first. bugnet-dev keys writes a fresh one to .env.keys, which dev-up.sh reads after this
# file, so leave it empty here unless you run the router without dev-up.sh.
BUGNET_DATA_PLANE_KEYS=
