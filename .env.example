# Secrets only. Copy this file to .env and paste each key after the = sign, no quotes, no
# spaces. Every other setting lives in config/dev.toml. dev-up.sh writes the router's own
# generated secrets to .env.keys. Leave a provider's line empty to skip that provider.

# The router's own Postgres database, create it once with createdb bugnet_router_dev
BUGNET_DATABASE_URL=postgres://localhost:5432/bugnet_router_dev?sslmode=disable

# boxd, created at https://app.boxd.sh/keys, starts with bxd_
BOXD_API_KEY=

# E2B, created at https://console.e2b.dev/?tab=keys, starts with e2b_
E2B_API_KEY=

# Koyeb, created at https://app.koyeb.com/settings/api
KOYEB_API_TOKEN=

# Boat, created at https://boat.dev/dashboard?tab=api-keys, starts with boat_
BOAT_API_KEY=
